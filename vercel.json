{
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "installCommand": "composer install --no-interaction --prefer-dist --no-progress",
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false"
  }
}
